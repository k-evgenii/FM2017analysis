# 1. Make sure you're on the dev branch and everything is committed
git status

# 2. Push your dev branch to remote (if not already done)
git push origin dev-YourName

# 3. Switch to main branch
git checkout main

# 4. Pull latest changes from origin/main
git pull origin main

# 5. Merge dev-YourName into main
git merge dev-YourName

# 6. Push the updated main to origin
git push origin main

# 7. Switch back to dev branch if you want to continue working there
git checkout dev-YourName